// jgcomutil.idl - the type library of JGraph's COM utility library for Excel add-ins (compiler and
// SDK plan, stage K17d; decision KO10): MathWorks' mwcomutil.tlb transcribed under JGraph's own ids
// and library name, so a VBA client ports by changing its CreateObject strings alone. The
// interfaces, their members, DISPIDs and parameters are MathWorks' (extern\include\mwcomtypes.idl
// and the IDL mwcomutil.h was generated from, R2025b); the enumerations' values are MathWorks'.
//
// The library is built into jgcomutil.dll as its TYPELIB resource 1 (native\jgcomutil\build.ps1),
// which registers itself from it (DllRegisterServer, native\jgxl\jgxl.cpp built with
// JGRAPH_COMUTIL) and whose objects the JGraph Runtime's native bridge serves (native\jgrt\src\com.cpp,
// one generic object per interface, the engine behind every member: JGraph.Runtime\Com). The
// three flags interfaces carry the same ids an add-in's own type library declares them under
// (JGraph.Deploy\ExcelTypeLib.cs, ExcelComGuids), so a flags object made by either library is
// taken by the other.
//
// Every parameter is a long, a VARIANT_BOOL, a BSTR, an interface pointer, a VARIANT or a pointer
// to one of these: on x64 each crosses as one pointer-sized slot, which is what jgrt's thunks read.
import "oaidl.idl";
import "ocidl.idl";

[
    uuid(526A7B33-1914-40DB-B25C-95FAB810E22F),
    helpstring("Array formatting options used in data conversion")
]
typedef enum mwArrayFormat
{
    mwArrayFormatAsIs = 0,
    mwArrayFormatMatrix = 1,
    mwArrayFormatCell = 2
} mwArrayFormat;

[
    uuid(4FA8F37E-9E9E-48B3-9BB0-BFA226863D2A),
    helpstring("Basic data type codes used in data conversion")
]
typedef enum mwDataType
{
    mwTypeDefault = 0,
    mwTypeLogical = 3,
    mwTypeChar = 4,
    mwTypeDouble = 6,
    mwTypeSingle = 7,
    mwTypeInt8 = 8,
    mwTypeUint8 = 9,
    mwTypeInt16 = 10,
    mwTypeUint16 = 11,
    mwTypeInt32 = 12,
    mwTypeUint32 = 13
} mwDataType;

[
    uuid(31CB634A-11B0-4021-AE1D-687420452C5F),
    helpstring("Format for date types used in data conversion")
]
typedef enum mwDateFormat
{
    mwDateFormatNumeric = 0,
    mwDateFormatString = 1
} mwDateFormat;

[
    uuid(0B8E8376-2F4B-4D30-8905-715074771F4A),
    helpstring("Missing data options used in data conversion")
]
typedef enum mwReplaceMissingData
{
    mwReplaceZero = 0,
    mwReplaceNaN = 1
} mwReplaceMissingData;

[
    uuid(0908076C-DD50-48D2-A8A6-499F6E5F3362),
    helpstring("Treating MATLAB NaN options used in data conversion")
]
typedef enum mwReplaceMatlabNaN
{
    mwReplaceWithEmptyCell = 0,
    mwReplaceWithZero = 1,
    mwReplaceWithExcelNaN = 2
} mwReplaceMatlabNaN;

[
