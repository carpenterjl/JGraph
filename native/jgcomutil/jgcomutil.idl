    [propget, id(1), helpstring("property ArrayFormatFlags")] HRESULT ArrayFormatFlags([out, retval] IMWArrayFormatFlags** ppFlags);
    [propput, id(1), helpstring("property ArrayFormatFlags")] HRESULT ArrayFormatFlags([in] IMWArrayFormatFlags* pFlags);
