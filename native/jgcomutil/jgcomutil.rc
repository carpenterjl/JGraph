// The utility library's resources: its type library (TYPELIB 1, built by midl from jgcomutil.idl
// into the build's work folder, which rc finds through /I) and a version block. Language-neutral,
// as the add-in template's are.
#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

1 TYPELIB "jgcomutil.tlb"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 25,2,0,0
 PRODUCTVERSION 25,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "JGraph COM utility library for Excel add-ins"
            VALUE "FileVersion", "25.2.0.0"
            VALUE "InternalName", "jgcomutil"
            VALUE "OriginalFilename", "jgcomutil.dll"
            VALUE "ProductName", "JGraph Runtime"
            VALUE "ProductVersion", "25.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
