// The server configuration add-in's resources: its dialog and the version block, all language-neutral.
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_CONFIG DIALOGEX 0, 0, 340, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configure Production Server"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Excel client:", -1, 12, 14, 70, 10
    COMBOBOX        IDC_ADDIN, 90, 12, 238, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Server URL:", -1, 12, 34, 70, 10
    EDITTEXT        IDC_URL, 90, 32, 238, 14, ES_AUTOHSCROLL
    LTEXT           "http://host:port/<archive>, as the server deploys the archive the client calls", IDC_NOTE, 90, 48, 238, 10
    LTEXT           "Timeout (seconds):", -1, 12, 64, 70, 10
    EDITTEXT        IDC_TIMEOUT, 90, 62, 60, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Response limit (MB):", -1, 170, 64, 80, 10
    EDITTEXT        IDC_LIMIT, 254, 62, 74, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "HTTPS certificate:", -1, 12, 84, 70, 10
    EDITTEXT        IDC_CERT, 90, 82, 190, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 284, 81, 44, 15
    GROUPBOX        "Client logging", -1, 12, 108, 316, 84
    CONTROL         "Enable client logging", IDC_LOGENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 124, 120, 10
    LTEXT           "Level:", -1, 24, 146, 50, 10
    COMBOBOX        IDC_LOGLEVEL, 90, 144, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Log folder:", -1, 24, 168, 60, 10
    EDITTEXT        IDC_LOGFOLDER, 90, 166, 190, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_LOGBROWSE, 284, 165, 44, 15
    DEFPUSHBUTTON   "OK", IDOK, 228, 206, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 282, 206, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "JGraph Server Configuration add-in for Excel"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductName", "JGraph"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
