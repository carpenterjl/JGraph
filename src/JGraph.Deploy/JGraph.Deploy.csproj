<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The build side of the compiler and SDK plan, headless and free of the engine: what R2025b's
    dependency analysis knows that the code cannot say (which product owns a name, which files the
    runtime leaves out, which functions read a data file), the report the analyser fills, and the
    log files a build writes beside its target (stage K2); the archive, its manifest, the runtime
    cache it is extracted into and the extractCTF utility (stage K3). Later stages add the target
    writers. The analyser itself walks JGS syntax trees and lives in JGraph.Scripting, which
    references this.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JGraph.Deploy</RootNamespace>
    <Description>The build side of JGraph's compiler: R2025b's dependency rules and products, the dependency report, the build log files, the archive and the runtime cache.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JGraph.Scripting" />
    <InternalsVisibleTo Include="JGraph.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stage K8: a .NET assembly's generated classes are compiled in process, where R2025b runs csc or the .NET SDK. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stage K2's probe_k2_names: each name's products and file in R2025b, and the files mcc leaves out. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\compiler-probes\recordings\k2_names.out.txt" LogicalName="JGraph.Deploy.r2025b-names.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stage K6: the launcher templates mcc -m and -e copy (native/jglaunch, built by its build.ps1
         and checked in), beside every program that can build one. -->
    <None Include="..\..\native\win-x64\launchers\jglaunch-console.exe;..\..\native\win-x64\launchers\jglaunch-gui.exe"
          Link="launchers\win64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Stage K17c: the Excel add-in template mcc -W excel copies and stamps (native/jgxl, built by its build.ps1 and checked in). -->
    <None Include="..\..\native\win-x64\jgxl\jgxl.dll" Link="launchers\win64\jgxl.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Stage K17f: the Excel client template mcc -W mpsxl copies and stamps, JGraph's server configuration add-in for Excel and the client installer template (native/jgxlmps, jgxlconfig, jgxlsetup). -->
    <None Include="..\..\native\win-x64\jgxlmps\jgxlmps.dll" Link="launchers\win64\jgxlmps.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\native\win-x64\jgxlconfig\jgxlconfig.dll" Link="launchers\win64\jgxlconfig.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\native\win-x64\jgxlconfig\jgxlconfig.dll')" />
    <None Include="..\..\native\win-x64\jgxlsetup\jgxlsetup.exe" Link="launchers\win64\jgxlsetup.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\native\win-x64\jgxlsetup\jgxlsetup.exe')" />
    <!-- compiler.build's default icon and splash, where R2025b keeps its own under matlabroot. -->
    <None Include="PackagingResources\default_icon_48.png;PackagingResources\default_splash.png;PackagingResources\default_logo.png"
          Link="toolbox\compiler\packagingResources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Stage K7: mcc -B's bundle files, under R2025b's names. -->
    <None Include="Bundles\*" Link="toolbox\compiler\bundles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Stage K11: a C shared library is compiled against the JGraph Runtime's headers and linked with
         jgrt.lib (native/jgrt, stage K10), carried beside JGraph where MATLAB keeps its own. -->
    <None Include="..\..\native\jgrt\include\*.h" Link="extern\include\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Stage K12: the C++ shared library API, JGraph's own headers under MATLAB's names. -->
    <None Include="..\..\native\jgrt\include\*.hpp" Link="extern\include\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\native\jgrt\include\jgraph\*" Link="extern\include\jgraph\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\native\jgrt\include\MatlabDataArray\*" Link="extern\include\MatlabDataArray\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\native\win-x64\jgrt\jgrt.lib" Link="extern\lib\win64\microsoft\jgrt.lib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Stage K13: the JGraph Runtime's python folder, the matlab module and the matlab_pysdk runtime a
         Python package imports, beside JGraph as the runtime keeps it beside its engine. -->
    <None Include="..\..\python\jgraph_runtime\**\*.py" Link="python\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Stage K8: the generated classes are compiled against .NET 8's reference assemblies, so a client
       compiles against them; carried beside JGraph from the targeting pack this project builds with. -->
  <Target Name="CarryReferenceAssemblies" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <None Include="@(Reference)" Condition="'%(Reference.FrameworkReferenceName)' == 'Microsoft.NETCore.App'"
            Link="toolbox\dotnetbuilder\ref\net8.0\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
