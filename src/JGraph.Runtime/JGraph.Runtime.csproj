<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The JGraph Runtime's public face (compiler and SDK plan, stage K4): the runtime a process starts
    once, the components it opens from archives, the calls into them on one engine thread, and the
    values that cross. Headless and free of WPF, so the libraries and the server built on it stay
    possible off Windows (decision KO5). The SDK mirrors of later stages (MWArray, the MATLAB Data
    API, the native bridge) are built over this.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JGraph.Runtime</RootNamespace>
    <Description>The JGraph Runtime: opens deployable archives and calls their functions from .NET, on one engine thread, with a lossless value model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JGraph.Tests" />
    <!-- The window host (stage K5) implements IRuntimeDesktop and is found by name at run time. -->
    <InternalsVisibleTo Include="JGraph.Runtime.Desktop" />
    <!-- The MWArray API (stage K8) reads a component's signatures and the runtime's options. -->
    <InternalsVisibleTo Include="JGraph.MATLAB.NET.Arrays" />
    <!-- The MATLAB Data API (stage K9) runs its conversions and calls on the engine thread through a component's session. -->
    <InternalsVisibleTo Include="JGraph.MATLAB.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JGraph.Scripting\JGraph.Scripting.csproj" />
    <ProjectReference Include="..\JGraph.Deploy\JGraph.Deploy.csproj" />
    <ProjectReference Include="..\JGraph.Export\JGraph.Export.csproj" />
  </ItemGroup>

</Project>
