<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JGraph.Scripting</RootNamespace>
    <!-- The native host's client compares the process environment block in place (ADR 0180). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Scripting hosts for JGraph: a language-agnostic IScriptEngine seam with a Roslyn C# engine and a pythonnet (CPython) engine that drive the JG API and the tabular data readers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The packed-array parity tests and benchmarks flip the internal JgsPacking switch per run. -->
    <InternalsVisibleTo Include="JGraph.Tests" />
    <InternalsVisibleTo Include="JGraph.Benchmarks" />
    <!-- The JGraph Runtime's facade, the one public face of the engine for a deployed component's
         clients (compiler and SDK plan, stage K4, section 7.2 choice 7). -->
    <InternalsVisibleTo Include="JGraph.Runtime" />
    <InternalsVisibleTo Include="JGraph.MATLAB.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The out-of-process Python console's child script, copied beside every host that references
         this project (the WPF app and the CLI launcher both need it). The JGraph Runtime's own python
         folder (python\jgraph_runtime, stage K13) is JGraph.Deploy's to copy. -->
    <Content Include="..\..\python\*.py" LinkBase="python" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The R2025b dispatch sweep (M145): per built-in name and argument pattern, whether a built-in
         class method outranks a same-named user file. One copy, kept where the sweep scripts and the
         verifier live, and read by JgsDispatchTable at run time. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\matlab-r2025b-dispatch.csv" LogicalName="JGraph.Scripting.dispatch-table.csv" />
    <EmbeddedResource Include="..\..\tools\matlab-checklist\dispatch-class-map.csv" LogicalName="JGraph.Scripting.dispatch-class-map.csv" />

    <!-- The visual designer's component catalog (designer plan DS1): per uifigure component class,
         R2025b App Designer's generated property order, mode siblings and run-time defaults, as the
         probe ds1_catalog records them. One copy, kept beside the probe and read by DesignCatalog. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\ds1\ds1_catalog.json" LogicalName="JGraph.Scripting.designer-catalog.json" />
    <!-- Designer plan DS1b (ADR 0244): what a fresh component of each class stores in App Designer's
         saved tree, as the probe ds1b_base records it from R2025b. Read by DesignTreeWriter. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\ds1b\ds1b_base.json" LogicalName="JGraph.Scripting.designer-base.json" />
    <!-- Designer plan DS7b: what a custom component (a ComponentContainer subclass) stores in App
         Designer's saved tree besides its own properties, as the probe ds7_base records it from the
         SpinnerGauge the probe ds7_uac saved. Read by DesignTreeWriter. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\ds7\ds7_uac_base.json" LogicalName="JGraph.Scripting.designer-uac-base.json" />
    <!-- Designer plan DS3: App Designer's inspector per class (probe ds3_inspector) and what its
         palette's design-time component of each class holds (probe ds3_palette). Read by
         DesignInspector and DesignPalette. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\ds3\ds3_inspector.json" LogicalName="JGraph.Scripting.designer-inspector.json" />
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\ds3\ds3_palette.json" LogicalName="JGraph.Scripting.designer-palette.json" />
    <!-- Designer plan DS5: per class, App Designer's callback properties, the comment it writes over a
         callback bound to each, and the code a new callback starts with, read from its bundle's
         component models under node (ds5/). Read by DesignCallbacks. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\ds5\ds5_callbacks.json" LogicalName="JGraph.Scripting.designer-callbacks.json" />
    <!-- App Designer window plan W0/W2: App Designer's toolstrip and its 202 actions as R2025b's client
         builds them, recorded under node (ui-probes/w0/oracle). Read by DesignToolstrip and DesignActions. -->
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\w0\w0_toolstrip.json" LogicalName="JGraph.Scripting.designer-toolstrip.json" />
    <EmbeddedResource Include="..\..\tools\matlab-checklist\ui-probes\w0\w0_actions.json" LogicalName="JGraph.Scripting.designer-actions.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.9.2" />
    <PackageReference Include="pythonnet" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JGraph.Core\JGraph.Core.csproj" />
    <ProjectReference Include="..\JGraph.Math\JGraph.Math.csproj" />
    <ProjectReference Include="..\JGraph.Numerics\JGraph.Numerics.csproj" />
    <ProjectReference Include="..\JGraph.Signal\JGraph.Signal.csproj" />
    <ProjectReference Include="..\JGraph.Imaging\JGraph.Imaging.csproj" />
    <ProjectReference Include="..\JGraph.Statistics\JGraph.Statistics.csproj" />
    <ProjectReference Include="..\JGraph.Imaging.Codecs\JGraph.Imaging.Codecs.csproj" />
    <ProjectReference Include="..\JGraph.Data\JGraph.Data.csproj" />
    <ProjectReference Include="..\JGraph.Objects\JGraph.Objects.csproj" />
    <ProjectReference Include="..\JGraph.Api\JGraph.Api.csproj" />

    <!-- The native library host (ADR 0180): its protocol types are shared from its assembly, and the
         reference carries the executable, its runtimeconfig and deps into every host's output. -->
    <ProjectReference Include="..\JGraph.NativeHost\JGraph.NativeHost.csproj" />

    <!-- Device I/O (device classes plan, architecture B): the serial, socket and USB backends and the
         device simulator, in process; nothing a device object does runs in the native host. -->
    <ProjectReference Include="..\JGraph.Devices\JGraph.Devices.csproj" />

    <!-- Bluetooth (device classes plan, stage D3) targets a Windows SDK framework for the WinRT
         projection, so it is built but not linked: JGraph.Devices loads it at run time, and the target
         below copies it and its projection into this project's output and every host's. -->
    <ProjectReference Include="..\JGraph.Devices.Bluetooth\JGraph.Devices.Bluetooth.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" />

    <!-- copyobj copies a figure object by writing it out and reading it back, so the one description
         of what a plot is made of stays the document format's rather than becoming a second one. -->
    <ProjectReference Include="..\JGraph.Serialization\JGraph.Serialization.csproj" />

    <!-- The compiler's build side (compiler and SDK plan, stage K2): R2025b's dependency rules and
         products, the report the dependency analyser fills and the build's log files. -->
    <ProjectReference Include="..\JGraph.Deploy\JGraph.Deploy.csproj" />
  </ItemGroup>

  <!-- The Bluetooth backend and its WinRT projection, as copy-to-output items so that every project
       referencing this one gets them too. Added in a target, after the backend has been built. -->
  <Target Name="IncludeBluetoothBackend" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_BluetoothOut>$(MSBuildThisFileDirectory)..\JGraph.Devices.Bluetooth\bin\$(Configuration)\net8.0-windows10.0.19041.0\</_BluetoothOut>
    </PropertyGroup>
    <ItemGroup>
      <None Include="$(_BluetoothOut)JGraph.Devices.Bluetooth.dll;$(_BluetoothOut)Microsoft.Windows.SDK.NET.dll;$(_BluetoothOut)WinRT.Runtime.dll"
            Condition="Exists('$(_BluetoothOut)JGraph.Devices.Bluetooth.dll')"
            Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
