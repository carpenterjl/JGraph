<UserControl x:Class="JGraph.Controls.Scripting.ScriptEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit">
    <Grid x:Name="Root">
        <avalon:TextEditor x:Name="Editor"
                           FontFamily="{DynamicResource JG.Font.Mono}"
                           FontSize="{DynamicResource JG.FontSize.Code}"
                           Background="{DynamicResource JG.Brush.EditorBackground}"
                           Foreground="{DynamicResource JG.Brush.EditorForeground}"
                           LineNumbersForeground="{DynamicResource JG.Brush.LineNumber}"
                           ShowLineNumbers="True" WordWrap="False"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           TextChanged="OnEditorTextChanged" />
        <!-- The split document's second view and the bar between them (App Designer window plan W9c); shown by SetSplit. -->
        <GridSplitter x:Name="Splitter" Visibility="Collapsed" Background="{DynamicResource JG.Brush.Separator}" Focusable="False" />
        <avalon:TextEditor x:Name="Editor2" Visibility="Collapsed"
                           FontFamily="{DynamicResource JG.Font.Mono}"
                           FontSize="{DynamicResource JG.FontSize.Code}"
                           Background="{DynamicResource JG.Brush.EditorBackground}"
                           Foreground="{DynamicResource JG.Brush.EditorForeground}"
                           LineNumbersForeground="{DynamicResource JG.Brush.LineNumber}"
                           ShowLineNumbers="True" WordWrap="False"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />
        <!-- The Find and Replace strip stands over the text's top right corner, clear of the scroll bar (App Designer window plan W9a). -->
        <ContentControl x:Name="StripHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,18,0" Focusable="False" />
    </Grid>
</UserControl>
