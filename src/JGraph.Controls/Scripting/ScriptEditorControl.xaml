<UserControl x:Class="JGraph.Controls.Scripting.ScriptEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit">
    <avalon:TextEditor x:Name="Editor"
                       FontFamily="{DynamicResource JG.Font.Mono}"
                       FontSize="{DynamicResource JG.FontSize.Code}"
                       Background="{DynamicResource JG.Brush.EditorBackground}"
                       Foreground="{DynamicResource JG.Brush.EditorForeground}"
                       LineNumbersForeground="{DynamicResource JG.Brush.LineNumber}"
                       ShowLineNumbers="True" WordWrap="False"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       TextChanged="OnEditorTextChanged" />
</UserControl>
