<!--
    Theme-independent styles: implicit Style entries that colour WPF's stock controls from the theme
    keys. Merged once at application start and never swapped — the theme dictionary beside it is what
    changes.

    Three rules govern everything here.

    1. Colours are referenced with DynamicResource, never StaticResource. A StaticResource is resolved
       when the style is loaded and would bake the startup theme in for the life of the process.

    2. Foreground is set on *containers*, not on TextBlock. TextBlock.Foreground inherits, so a Window
       or a ListViewItem setting it reaches every label inside. An implicit TextBlock style would beat
       that inheritance and paint body text over a selected row's highlight — the classic WPF dark-mode
       bug where selection looks right until you notice you cannot read the selected row.

    3. Controls whose stock Aero2 template hard-codes its own hover, pressed and disabled colours get a
       replacement template. Setting Background alone on a Button leaves it flashing #FFBEE6FD on
       hover — a light-blue wash on a dark toolbar. The templates below keep Aero2's geometry
       (paddings, arrow sizes, the 1px border) and change only where the colours come from.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================================
         Window and dialogs
         ==================================================================================== -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource JG.Font.UI}" />
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Padding" Value="5,5,5,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================================
         Text input
         ==================================================================================== -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource JG.Brush.Selection}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Panel}" />
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JG.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================================
         Buttons

         One template serves Button, ToggleButton and RepeatButton: the visual states are the same,
         and a ToggleButton simply adds IsChecked on top of them.
         ==================================================================================== -->

    <ControlTemplate x:Key="JG.Template.Button" TargetType="ButtonBase">
        <Border x:Name="Bd" SnapsToDevicePixels="True"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JG.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Panel}" />
                <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource JG.Template.Button}" />
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.SelectionText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================================
         Check boxes and radio buttons

         The stock bullet chrome is a gradient-filled path that reads as a dent on a light surface
         and as a smudge on a dark one, so both get a flat box/dot instead.
         ==================================================================================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.ControlBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="13" Height="13" SnapsToDevicePixels="True"
                                VerticalAlignment="Center" Margin="0,0,5,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Path x:Name="Tick" Visibility="Collapsed" Margin="1,2,1,1"
                                  Stretch="Uniform" StrokeThickness="1.6"
                                  Stroke="{DynamicResource JG.Brush.Accent}"
                                  Data="M 0,3 L 2.5,6 L 8,0" />
                        </Border>
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource JG.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource JG.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource JG.Brush.Panel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.ControlBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0">
                            <Ellipse x:Name="Box" SnapsToDevicePixels="True"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="5" Height="5" Visibility="Collapsed"
                                     Fill="{DynamicResource JG.Brush.Accent}" />
                        </Grid>
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource JG.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
                            <Setter TargetName="Box" Property="Fill" Value="{DynamicResource JG.Brush.Panel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================================
         Scroll bars

         Aero2 hard-codes its track and thumb, so a dark pane would keep a bright grey scroll bar
         glued to its edge. Geometry matches the stock 17px metric so nothing reflows.
         ==================================================================================== -->

    <Style x:Key="JG.Style.ScrollBarLine" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <Path x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource JG.Brush.TextSecondary}"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource JG.Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JG.Style.ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JG.Style.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Margin="1" CornerRadius="1"
                            Background="{DynamicResource JG.Brush.ControlBorder}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Panel}" />
        <Setter Property="Width" Value="17" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="17" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="17" />
                        </Grid.RowDefinitions>
                        <RepeatButton Grid.Row="0" Style="{StaticResource JG.Style.ScrollBarLine}"
                                      Command="ScrollBar.LineUpCommand" Content="M 0,4 L 8,4 L 4,0 Z" />
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource JG.Style.ScrollBarPage}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource JG.Style.ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource JG.Style.ScrollBarPage}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <RepeatButton Grid.Row="2" Style="{StaticResource JG.Style.ScrollBarLine}"
                                      Command="ScrollBar.LineDownCommand" Content="M 0,0 L 8,0 L 4,4 Z" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="17" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton Grid.Column="0" Style="{StaticResource JG.Style.ScrollBarLine}"
                                              Command="ScrollBar.LineLeftCommand" Content="M 4,0 L 4,8 L 0,4 Z" />
                                <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource JG.Style.ScrollBarPage}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource JG.Style.ScrollBarThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource JG.Style.ScrollBarPage}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Column="2" Style="{StaticResource JG.Style.ScrollBarLine}"
                                              Command="ScrollBar.LineRightCommand" Content="M 0,0 L 0,8 L 4,4 Z" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================================================
         Combo box
         ==================================================================================== -->

    <Style x:Key="JG.Style.ComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" SnapsToDevicePixels="True"
                            Background="{DynamicResource JG.Brush.Surface}"
                            BorderBrush="{DynamicResource JG.Brush.ControlBorder}" BorderThickness="1">
                        <Border x:Name="Arrow" Width="17" HorizontalAlignment="Right"
                                Background="{DynamicResource JG.Brush.Control}">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{DynamicResource JG.Brush.Text}" Data="M 0,0 L 7,0 L 3.5,4 Z" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JG.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Panel}" />
                            <Setter TargetName="Arrow" Property="Background" Value="{DynamicResource JG.Brush.Panel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JG.Style.ComboBoxEditableText" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource JG.Brush.Selection}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="MinHeight" Value="21" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{StaticResource JG.Style.ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="Selected" Margin="{TemplateBinding Padding}"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Style="{StaticResource JG.Style.ComboBoxEditableText}"
                                 Margin="{TemplateBinding Padding}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               Placement="Bottom" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource JG.Brush.Surface}"
                                    BorderBrush="{DynamicResource JG.Brush.Border}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <!-- The arrow keeps the click; the text area must not swallow it. -->
                            <Setter TargetName="PART_EditableTextBox" Property="Margin" Value="5,2,19,2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.SelectionText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================================
         Lists and trees
         ==================================================================================== -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource JG.Brush.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource JG.Brush.SelectionText}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ListViewItem gets its own template rather than only setters: the stock one paints a gradient
        selection rectangle in a separate layer that ignores Background entirely, so a selected row
        would keep Aero's blue wash whatever the theme says.
    -->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{Binding View.Columns,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.SelectionText}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource JG.Brush.GridHeader}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="Bd" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource JG.Brush.GridLine}"
                            BorderThickness="0,0,1,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
    </Style>

    <Style x:Key="JG.Style.TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="4">
                        <Path x:Name="Glyph" Stretch="Uniform"
                              Fill="{DynamicResource JG.Brush.TextSecondary}"
                              Data="M 0,0 L 4,4 L 0,8 Z" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Data" Value="M 0,4 L 8,4 L 8,0 Z" />
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource JG.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource JG.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource JG.Style.TreeExpander}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Bd" Grid.Row="0" Grid.Column="1" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ItemsPresenter x:Name="Items" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.SelectionText}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================================
         Menus

         MenuItem needs one template per Role. WPF picks between them with triggers, which is why
         this section is the longest one here for the least visual novelty.
         ==================================================================================== -->

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Menu}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Menu}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="0,2">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="JG.Template.MenuSubmenu" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stretch="Uniform" Width="9" StrokeThickness="1.6"
                      Stroke="{DynamicResource JG.Brush.Accent}" Data="M 0,3 L 2.5,6 L 8,0" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  Margin="0,3" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource JG.Brush.TextSecondary}" />
                <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="{DynamicResource JG.Brush.Text}" Data="M 0,0 L 4,3.5 L 0,7 Z" />
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       Placement="Right" HorizontalOffset="-2"
                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                    <Border Background="{DynamicResource JG.Brush.Menu}"
                            BorderBrush="{DynamicResource JG.Brush.Border}" BorderThickness="1"
                            Padding="0,2">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="JG.Template.MenuTopLevel" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="8,4">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}">
                    <Border Background="{DynamicResource JG.Brush.Menu}"
                            BorderBrush="{DynamicResource JG.Brush.Border}" BorderThickness="1"
                            Padding="0,2">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource JG.Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Template" Value="{StaticResource JG.Template.MenuSubmenu}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource JG.Template.MenuTopLevel}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource JG.Template.MenuTopLevel}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Separator}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A Separator inside a Menu resolves this key rather than the implicit style above. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}" />

    <!-- ====================================================================================
         Toolbars and status bar
         ==================================================================================== -->

    <Style TargetType="ToolBarTray">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.ToolBar}" />
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.ToolBar}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Border Background="{TemplateBinding Background}" Padding="2">
                        <ToolBarPanel IsItemsHost="True" Margin="0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A Separator inside a ToolBar is vertical, not a horizontal rule. -->
    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Separator}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Width="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}" />
    <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.StatusBar}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource JG.Brush.Separator}"
                            BorderThickness="0,1,0,0" Padding="6,2">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
    </Style>

    <!-- ====================================================================================
         Containers
         ==================================================================================== -->

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,0,3" FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                        <Border Grid.Row="1" SnapsToDevicePixels="True"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Separator}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="6,3" MaxWidth="420">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
    </Style>

    <!-- ====================================================================================
         Data grid
         ==================================================================================== -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JG.Brush.Border}" />
        <Setter Property="RowBackground" Value="{DynamicResource JG.Brush.Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource JG.Brush.GridRowAlt}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource JG.Brush.GridLine}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource JG.Brush.GridLine}" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource JG.Brush.GridHeader}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource JG.Brush.GridLine}" BorderThickness="0,0,1,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource JG.Brush.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JG.Brush.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource JG.Brush.SelectionText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
