<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The look of a script's components (app-building plan, section G, stage U1). Every style is
        keyed and applied explicitly, so the IDE's implicit styles in Shared.xaml never reach a
        component: a uicontrol wears MATLAB's defaults and the colours its script gave it, whatever
        the IDE theme is.
    -->

    <Style x:Key="JG.Ui.PushButton" TargetType="Button">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="BorderBrush" Value="#FFADADAD" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Shade" Background="#00000000" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="#FF0078D7" />
                            <Setter TargetName="Shade" Property="Background" Value="#140078D7" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="#FF0078D7" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shade" Property="Background" Value="#300078D7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF9E9E9E" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="#FFCCCCCC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JG.Ui.Edit" TargetType="TextBox">
        <Setter Property="BorderBrush" Value="#FFABADB3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#FF0078D7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF9E9E9E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JG.Ui.Text" TargetType="Border">
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The rest of the uicontrol styles (U3). A toggle button is a push button that stays down. -->
    <Style x:Key="JG.Ui.ToggleButton" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="BorderBrush" Value="#FFADADAD" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Shade" Background="#00000000" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="#FF0078D7" />
                            <Setter TargetName="Shade" Property="Background" Value="#140078D7" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="#FF0078D7" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="#FF005A9E" />
                            <Setter TargetName="Shade" Property="Background" Value="#400078D7" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shade" Property="Background" Value="#300078D7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF9E9E9E" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="#FFCCCCCC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A check box, a radio button, a slider, a list and a drop-down list wear the system's own
         templates: a style with a key and no BasedOn stands on the theme's, not on the IDE's. -->
    <Style x:Key="JG.Ui.CheckBox" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <Style x:Key="JG.Ui.RadioButton" TargetType="RadioButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <Style x:Key="JG.Ui.Slider" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="JG.Ui.Frame" TargetType="Border">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="JG.Ui.ListBox" TargetType="ListBox">
        <Setter Property="BorderBrush" Value="#FFABADB3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- The arrows of a uispinner, and the bar of a uiprogressdlg (U5). -->
    <Style x:Key="JG.Ui.SpinButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="BorderBrush" Value="#FFABADB3" />
        <Setter Property="BorderThickness" Value="0,1,1,1" />
        <Setter Property="Background" Value="#FFF5F5F5" />
    </Style>

    <Style x:Key="JG.Ui.Progress" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="#FF268CDD" />
        <Setter Property="Background" Value="#FFD1D1D1" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="JG.Ui.PopupMenu" TargetType="ComboBox">
        <Setter Property="IsEditable" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
</ResourceDictionary>
