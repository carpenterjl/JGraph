<Window x:Class="JGraph.Application.Startup.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting JGraph" Width="560" Height="368"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True">
    <Grid>
        <!-- The fallback ground, and the only thing here that is a rectangle. It is shown when no
             artwork was found at all; an animation replaces it outright, because the animation is
             drawn on no page and a panel behind it would put the page back. -->
        <Border x:Name="Panel" CornerRadius="8" BorderThickness="1" BorderBrush="#FF2C3E50">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF223447" Offset="0" />
                    <GradientStop Color="#FF16222E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- The replaceable artwork, in two forms. The animation is a background and the wordmark
             stays over it; a still replaces the wordmark, which is what it has always meant. Both
             are hidden until something is actually loaded, so a missing or unreadable file simply
             leaves the built-in design showing. -->
        <Image x:Name="Animation" Stretch="Uniform" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Image x:Name="Artwork" Stretch="Uniform" Margin="0" Visibility="Collapsed" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Over a surface with nothing behind it the text has no ground of its own, so it
                 carries one: a tight shadow with no offset, dark and opaque, which reads as an
                 outline rather than as a glow and so holds on a white desktop as well as a black
                 one. The inner shadows on the runs themselves stack with it — one soft blur alone
                 spreads too far to be worth anything against a pale ground. -->
            <StackPanel x:Name="DefaultArtwork" Grid.Row="0"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0">
                <StackPanel.Effect>
                    <DropShadowEffect Color="#FF00060C" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                </StackPanel.Effect>
                <TextBlock Text="JGraph" FontSize="46" FontWeight="Light" Foreground="White"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF00060C" BlurRadius="4" ShadowDepth="0" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="scientific graphing and scripting" FontSize="13" Margin="0,4,0,0"
                           Foreground="#FFE7F0F8" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF00060C" BlurRadius="3" ShadowDepth="0" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="26,0,26,22">
                <StackPanel.Effect>
                    <DropShadowEffect Color="#FF00060C" BlurRadius="9" ShadowDepth="0" Opacity="1" />
                </StackPanel.Effect>
                <TextBlock x:Name="Caption" Text="Starting…" FontSize="12" Foreground="#FFE7F0F8"
                           Margin="0,0,0,6" TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF00060C" BlurRadius="3" ShadowDepth="0" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1"
                             Background="#B216222E" BorderThickness="0" Foreground="#FF4A90D9" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
