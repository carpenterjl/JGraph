<Window x:Class="JGraph.Application.Startup.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting JGraph" Width="460" Height="260"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True">
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="#FF2C3E50">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF223447" Offset="0" />
                <GradientStop Color="#FF16222E" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The replaceable artwork. Hidden until an image is actually loaded, so a missing or
                 unreadable file simply leaves the built-in wordmark showing. -->
            <Image x:Name="Artwork" Grid.Row="0" Stretch="Uniform" Margin="0"
                   Visibility="Collapsed" />

            <StackPanel x:Name="DefaultArtwork" Grid.Row="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="JGraph" FontSize="46" FontWeight="Light" Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="scientific graphing and scripting" FontSize="13" Margin="0,4,0,0"
                           Foreground="#FF8FA6BC" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="20,0,20,18">
                <TextBlock x:Name="Caption" Text="Starting…" FontSize="12" Foreground="#FFB8C9D9"
                           Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1"
                             Background="#FF16222E" BorderThickness="0" Foreground="#FF4A90D9" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
