<Window x:Class="JGraph.Application.Scripting.ScriptWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:controls="clr-namespace:JGraph.Controls.Scripting;assembly=JGraph.Controls"
        xmlns:local="clr-namespace:JGraph.Application.Scripting"
        Title="JGraph" Width="1180" Height="760">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="NewScriptMenu" Header="_New Script" />
                <Separator />
                <MenuItem Header="_Open File…" Command="{x:Static local:WorkspaceCommands.OpenFile}" />
                <MenuItem Header="Open _Workspace…" Command="{x:Static local:WorkspaceCommands.OpenWorkspace}" />
                <Separator />
                <MenuItem Header="_Save" Command="{x:Static local:WorkspaceCommands.Save}" />
                <MenuItem Header="Save _As…" Command="{x:Static local:WorkspaceCommands.SaveAs}" />
                <MenuItem Header="_Close Tab" Command="{x:Static local:WorkspaceCommands.CloseTab}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{x:Static local:WorkspaceCommands.Exit}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="Undo" />
                <MenuItem Header="_Redo" Command="Redo" />
                <Separator />
                <MenuItem Header="Cu_t" Command="Cut" />
                <MenuItem Header="_Copy" Command="Copy" />
                <MenuItem Header="_Paste" Command="Paste" />
                <Separator />
                <MenuItem Header="Select _All" Command="SelectAll" />
                <MenuItem Header="_Find…" Command="Find" />
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="_View" />
            <MenuItem Header="_Run">
                <MenuItem x:Name="RunMenuItem" Header="_Run"
                          Command="{x:Static local:WorkspaceCommands.RunOrContinue}" />
                <MenuItem Header="_Stop" Command="{x:Static local:WorkspaceCommands.Stop}" />
                <MenuItem Header="_Pause" Command="{x:Static local:WorkspaceCommands.Pause}" />
                <Separator />
                <MenuItem Header="Step _Over" Command="{x:Static local:WorkspaceCommands.StepOver}" />
                <MenuItem Header="Step _In" Command="{x:Static local:WorkspaceCommands.StepIn}" />
                <MenuItem Header="Step Ou_t" Command="{x:Static local:WorkspaceCommands.StepOut}" />
                <Separator />
                <MenuItem Header="C_lear Workspace"
                          Command="{x:Static local:WorkspaceCommands.ClearWorkspace}" />
                <Separator />
                <MenuItem Header="Toggle _Breakpoint"
                          Command="{x:Static local:WorkspaceCommands.ToggleBreakpoint}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="New _Figure Window"
                          Command="{x:Static local:WorkspaceCommands.NewFigureWindow}" />
                <Separator />
                <MenuItem Header="_Options…" Command="{x:Static local:WorkspaceCommands.Options}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Scripting Guide"
                          Command="{x:Static local:WorkspaceCommands.ScriptingGuide}" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar ToolBarTray.IsLocked="True">
                <Button Content="Open Workspace…" Padding="8,2"
                        Command="{x:Static local:WorkspaceCommands.OpenWorkspace}"
                        ToolTip="Open a folder of scripts and data files (Ctrl+Shift+O)" />
                <Button Content="Open File…" Padding="8,2"
                        Command="{x:Static local:WorkspaceCommands.OpenFile}"
                        ToolTip="Open a script file (Ctrl+O)" />
                <Button Content="Save" Padding="8,2"
                        Command="{x:Static local:WorkspaceCommands.Save}"
                        ToolTip="Save the active script (Ctrl+S)" />
                <Separator />
                <Button x:Name="RunButton" Content="▶ Run (F5)" Padding="10,2"
                        Command="{x:Static local:WorkspaceCommands.RunOrContinue}"
                        ToolTip="Run the active script; continues when paused (F5)" />
                <Button Content="⏸ Pause" Padding="8,2"
                        Command="{x:Static local:WorkspaceCommands.Pause}"
                        ToolTip="Pause the running script at its next statement" />
                <Button Content="■ Stop" Padding="10,2"
                        Command="{x:Static local:WorkspaceCommands.Stop}"
                        ToolTip="Stop the running script (Shift+F5)" />
                <Separator />
                <Button Content="Step Over" Padding="8,2"
                        Command="{x:Static local:WorkspaceCommands.StepOver}"
                        ToolTip="Execute the paused statement, running calls to completion (F10)" />
                <Button Content="Step In" Padding="8,2"
                        Command="{x:Static local:WorkspaceCommands.StepIn}"
                        ToolTip="Execute the paused statement, entering functions (F11)" />
                <Button Content="Step Out" Padding="8,2"
                        Command="{x:Static local:WorkspaceCommands.StepOut}"
                        ToolTip="Run until the current function returns (Shift+F11)" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>

        <dock:DockingManager x:Name="DockManager">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">
                    <dock:LayoutAnchorablePane DockWidth="230">
                        <dock:LayoutAnchorable Title="Files" ContentId="files" CanClose="False">
                            <DockPanel x:Name="FilesPanel">
                                <DockPanel DockPanel.Dock="Top" Margin="2">
                                    <Button x:Name="UpFolderButton" DockPanel.Dock="Left" Content="↑"
                                            Width="24" Margin="0,0,2,0" Click="OnUpFolderClick"
                                            ToolTip="Go to the parent folder" />
                                    <TextBox x:Name="AddressBox" VerticalContentAlignment="Center"
                                             KeyDown="OnAddressBoxKeyDown"
                                             ToolTip="Current workspace folder — type a path and press Enter" />
                                </DockPanel>
                                <TreeView x:Name="FilesTree" BorderThickness="0"
                                          MouseDoubleClick="OnFilesTreeDoubleClick" />
                            </DockPanel>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                    <dock:LayoutPanel Orientation="Vertical">
                        <dock:LayoutDocumentPane x:Name="DocumentPane" />
                        <dock:LayoutAnchorablePane DockHeight="170">
                            <dock:LayoutAnchorable Title="Console" ContentId="console" CanClose="False">
                                <DockPanel x:Name="ConsolePanel">
                                    <!-- The prompt row. Scrollback above it is shared with script runs,
                                         so one pane is the whole transcript of the session. -->
                                    <DockPanel DockPanel.Dock="Bottom" Margin="2">
                                        <ComboBox x:Name="ConsoleLanguage" DockPanel.Dock="Left" Width="90"
                                                  Margin="0,0,4,0" SelectionChanged="OnConsoleLanguageChanged"
                                                  ToolTip="The language the prompt runs" />
                                        <TextBlock DockPanel.Dock="Left" Text="&gt;&gt;" Margin="0,0,4,0"
                                                   FontFamily="{DynamicResource JG.Font.Mono}"
                                                   Foreground="{DynamicResource JG.Brush.Accent}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="ConsolePrompt"
                                                 FontFamily="{DynamicResource JG.Font.Mono}"
                                                 FontSize="{DynamicResource JG.FontSize.Normal}"
                                                 Background="{DynamicResource JG.Brush.EditorBackground}"
                                                 Foreground="{DynamicResource JG.Brush.EditorForeground}"
                                                 AcceptsReturn="True" MaxHeight="120"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Center"
                                                 PreviewKeyDown="OnConsolePromptKeyDown"
                                                 ToolTip="Enter runs · Shift+Enter adds a line · Up/Down recalls history · Ctrl+C interrupts" />
                                    </DockPanel>
                                    <TextBox x:Name="ConsoleBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                             FontFamily="{DynamicResource JG.Font.Mono}"
                                             FontSize="{DynamicResource JG.FontSize.Normal}"
                                             Background="{DynamicResource JG.Brush.EditorBackground}"
                                             Foreground="{DynamicResource JG.Brush.EditorForeground}"
                                             Padding="4,2"
                                             TextWrapping="NoWrap" BorderThickness="0"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto" />
                                </DockPanel>
                            </dock:LayoutAnchorable>
                            <dock:LayoutAnchorable Title="Data Viewer" ContentId="dataviewer" CanClose="False">
                                <controls:DataGridTableControl x:Name="DataViewer" />
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                    </dock:LayoutPanel>

                    <dock:LayoutPanel Orientation="Vertical" DockWidth="290">
                        <dock:LayoutAnchorablePane>
                            <dock:LayoutAnchorable Title="Workspace" ContentId="variables" CanClose="False">
                                <ListView x:Name="VariablesList" BorderThickness="0"
                                          MouseDoubleClick="OnVariablesDoubleClick"
                                          PreviewMouseRightButtonDown="OnVariablesRightButtonDown"
                                          ToolTip="Double-click an array, matrix, cell, struct or table to open it in the Data Viewer">
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="_Plot" Click="OnPlotVariableClick" />
                                            <MenuItem Header="Open in _Data Viewer" Click="OnOpenVariableClick" />
                                            <Separator />
                                            <MenuItem Header="C_lear Workspace"
                                                      Command="{x:Static local:WorkspaceCommands.ClearWorkspace}" />
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="90"
                                                            DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Type" Width="70"
                                                            DisplayMemberBinding="{Binding Type}" />
                                            <GridViewColumn Header="Value" Width="120"
                                                            DisplayMemberBinding="{Binding DisplayValue}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                        <dock:LayoutAnchorablePane DockHeight="180">
                            <dock:LayoutAnchorable Title="Call Stack" ContentId="callstack" CanClose="False">
                                <ListView x:Name="CallStackList" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Function" Width="110"
                                                            DisplayMemberBinding="{Binding FunctionName}" />
                                            <GridViewColumn Header="Line" Width="45"
                                                            DisplayMemberBinding="{Binding Line}" />
                                            <GridViewColumn Header="File" Width="120"
                                                            DisplayMemberBinding="{Binding SourceId}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                    </dock:LayoutPanel>
                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>
    </DockPanel>
</Window>
