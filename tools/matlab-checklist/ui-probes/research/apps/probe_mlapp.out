  AppBase Access=public Sealed=0 Static=0
  saveobj Access=public Sealed=0 Static=0
  delete Access=public Sealed=0 Static=0
  loadobj Access=public Sealed=0 Static=1
  getRunningApp Access=protected Sealed=1 Static=0
  setAutoResize Access=protected Sealed=1 Static=0
  registerApp Access=protected Sealed=1 Static=0
