--- feature flag
AppDesignerPlainTextFileFormat = 0
--- appModel.mat of a shipped app
  var appData class appdesigner.internal.serialization.app.AppData size [1 1]
  var code class struct size [1 1]
  var components class struct size [1 1]
  components: struct
    fields: UIFigure
      UIFigure -> matlab.ui.Figure [1 1]
  code: struct
    fields: ClassName, Callbacks, AppTypeData
      ClassName -> char [1 4]
      Callbacks -> struct [1 3]
      AppTypeData -> struct [1 1]
  appData: appdesigner.internal.serialization.app.AppData
--- minimal mlapp (no appModel.mat)
which: <research>\apps\built\min\ProbeApp.mlapp
exist: 2
getCode first line: classdef ProbeApp < matlab.apps.AppBase
superclass: matlab.apps.AppBase
methods: AddButtonPushed, ProbeApp, UIFigureCloseRequest, addlistener, addlistener, addlistener, addlistener, addlistener, addlistener, addlistener, addlistener, addlistener, addlistener, createCallbackFcn, createComponents, delete, empty, eq, findobj, findprop, ge, getRunningApp, gt, isvalid, le, listener, listener, listener, listener, listener, listener, listener, listener, listener, listener, loadobj, lt, ne, notify, notify, peek, refresh, registerApp, runStartupFcn, saveobj, setAutoResize, startupFcn
class(app) = ProbeApp, isa AppBase = 1
figure visible = off
fig has RunningAppInstance = 1, same = 1
fig RunningInstanceFullFileName = <research>\apps\built\min\ProbeApp.mlapp
HandleVisibility = off
after startup Count=5 Log=startup
ButtonPushedFcn class function_handle : @(source,event)executeCallback(ams,app,callback,requiresEventData,event)
after cb Count=7 Log=startup,char
label = Count: 7
second construction returns same object = 1
private refresh refused: MATLAB:class:MethodRestricted
private prop write refused: MATLAB:class:SetProhibited
after close: isvalid(app)=0 isvalid(fig)=0
bare call: running app figures = 1, app valid = 1
delete(fig) -> isvalid(app) = 0
bare zip err: MATLAB:fileio:cantOpenFile | <research>\apps\built\bare\ProbeBare.mlapp: Can't open file.
--- typed property default
UIFigure: HasDefault=0 Validation class=matlab.ui.Figure
