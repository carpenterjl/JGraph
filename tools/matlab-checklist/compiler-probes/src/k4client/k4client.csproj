<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stage K4's client of R2025b's K4A and K4B .NET assemblies. record-k4.ps1 builds it with
       -p:K4Out=<the dn folder probe_k4_build wrote> and runs it through run-quiet.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CETCompat>false</CETCompat>
    <MatlabRoot Condition="'$(MatlabRoot)' == ''">C:\Program Files\MATLAB\R2025b</MatlabRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MWArray">
      <HintPath>$(MatlabRoot)\toolbox\dotnetbuilder\bin\win64\netstandard2.0\MWArray.dll</HintPath>
    </Reference>
    <Reference Include="K4A">
      <HintPath>$(K4Out)\K4A\K4A.dll</HintPath>
    </Reference>
    <Reference Include="K4B">
      <HintPath>$(K4Out)\K4B\K4B.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
