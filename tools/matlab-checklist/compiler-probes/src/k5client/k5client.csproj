<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stage K5's client of R2025b's K5 .NET assembly. record-k5.ps1 builds it with
       -p:K5Out=<the dn folder probe_k5_build wrote> and runs it through run-quiet.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CETCompat>false</CETCompat>
    <MatlabRoot Condition="'$(MatlabRoot)' == ''">C:\Program Files\MATLAB\R2025b</MatlabRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MWArray">
      <HintPath>$(MatlabRoot)\toolbox\dotnetbuilder\bin\win64\netstandard2.0\MWArray.dll</HintPath>
    </Reference>
    <Reference Include="K5">
      <HintPath>$(K5Out)\K5\K5.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
