<Project Sdk="Microsoft.NET.Sdk">
  <!-- The acceptance set's client of the MATLAB Data API for .NET (compiler and SDK plan, stage K22).
       accept-k22.ps1 builds it with -p:AccOut=<the data build's folder> against R2025b's
       MathWorks.MATLAB.Runtime and Types, or with -p:JGraph=true and -p:JGraphRuntime=<JGraph's
       JGraph.MATLAB.Runtime.dll> after turning the source's using lines to JGraph's namespaces. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CETCompat>false</CETCompat>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <MatlabRoot Condition="'$(MatlabRoot)' == ''">C:\Program Files\MATLAB\R2025b</MatlabRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(JGraph)' != 'true'">
    <Reference Include="MathWorks.MATLAB.Runtime">
      <HintPath>$(MatlabRoot)\extern\dotnet\netstandard2.0\MathWorks.MATLAB.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="MathWorks.MATLAB.Types">
      <HintPath>$(MatlabRoot)\extern\dotnet\netstandard2.0\MathWorks.MATLAB.Types.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(JGraph)' == 'true'">
    <Reference Include="JGraph.MATLAB.Runtime">
      <HintPath>$(JGraphRuntime)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AccData">
      <HintPath>$(AccOut)\AccData.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
