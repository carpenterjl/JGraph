<Project Sdk="Microsoft.NET.Sdk">
  <!-- The acceptance set's client of the MWArray API (compiler and SDK plan, stage K22). accept-k22.ps1
       builds it with -p:AccOut=<the net build's folder> against R2025b's MWArray.dll, or with
       -p:JGraph=true and -p:JGraphArrays=<JGraph's JGraph.MATLAB.NET.Arrays.dll> after turning the
       source's using lines to JGraph's namespaces. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CETCompat>false</CETCompat>
    <MatlabRoot Condition="'$(MatlabRoot)' == ''">C:\Program Files\MATLAB\R2025b</MatlabRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(JGraph)' != 'true'">
    <Reference Include="MWArray">
      <HintPath>$(MatlabRoot)\toolbox\dotnetbuilder\bin\win64\netstandard2.0\MWArray.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(JGraph)' == 'true'">
    <Reference Include="JGraph.MATLAB.NET.Arrays">
      <HintPath>$(JGraphArrays)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AccNet">
      <HintPath>$(AccOut)\AccNet.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
