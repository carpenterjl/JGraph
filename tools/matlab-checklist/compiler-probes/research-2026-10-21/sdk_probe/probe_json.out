--- NaNInfType object
[[1,{"mwdata":"NaN"},{"mwdata":"Inf"},{"mwdata":"-Inf"}]]
{"mwdata":[1,{"mwdata":"NaN"},{"mwdata":"Inf"},{"mwdata":"-Inf"}],"mwsize":[1,4],"mwtype":"double"}
{"mwdata":"NaN"}
{"mwdata":["Inf"],"mwsize":[1,1],"mwtype":"single"}

--- PrettyPrint
{
    "a":[
        [
            1,
            2
        ]
    ]
}

--- decode of hand JSON
DEC 5                                                            -> class=double size=[1 1]  reenc={"mwdata":[5],"mwsize":[1,1],"mwtype":"double"}
DEC [1,2,3]                                                      -> class=double size=[3 1]  reenc={"mwdata":[1,2,3],"mwsize":[3,1],"mwtype":"double"}
DEC [[1,2,3]]                                                    -> class=double size=[1 3]  reenc={"mwdata":[1,2,3],"mwsize":[1,3],"mwtype":"double"}
DEC [[1],[2],[3]]                                                -> class=double size=[3 1]  reenc={"mwdata":[1,2,3],"mwsize":[3,1],"mwtype":"double"}
DEC [[1,2],[3,4]]                                                -> class=double size=[2 2]  reenc={"mwdata":[1,3,2,4],"mwsize":[2,2],"mwtype":"double"}
DEC [[[1,2],[3,4]],[[5,6],[7,8]]]                                -> class=double size=[2 2 2]  reenc={"mwdata":[1,5,3,7,2,6,4,8],"mwsize":[2,2,2],"mwtype":"double"}
DEC []                                                           -> class=double size=[0 0]  reenc={"mwdata":[],"mwsize":[0,0],"mwtype":"double"}
DEC [[]]                                                         -> ERR MPS:MATLAB:JSON:DecodeMismatchedMWSize : Number of elements in "mwdata" does not match "mwsize" specified.
DEC {}                                                           -> class=struct size=[1 1]  reenc={"mwdata":{},"mwsize":[1,1],"mwtype":"struct"}
DEC true                                                         -> class=logical size=[1 1]  reenc={"mwdata":[true],"mwsize":[1,1],"mwtype":"logical"}
DEC [true,false]                                                 -> class=logical size=[2 1]  reenc={"mwdata":[true,false],"mwsize":[2,1],"mwtype":"logical"}
DEC "abc"                                                        -> class=char size=[1 3]  reenc={"mwdata":["abc"],"mwsize":[1,3],"mwtype":"char"}
DEC ["a","bc"]                                                   -> ERR MPS:MATLAB:JSON:DecodeInvalidArrayElemType : Arrays in small notation must contain JSON numbers, JSON booleans, or values {"mwdata":"NaN"}, {"mwdata":"Inf"}, or {"mwdata": "-Inf"}
DEC [1,"a"]                                                      -> ERR MPS:MATLAB:JSON:DecodeArrayInconsistentTypes : Array in small notation cannot have multiple types. Use only double or only char values.
DEC [1,[2,3]]                                                    -> ERR MPS:MATLAB:JSON:DecodeArrayInconsistentDepths : Nested arrays in small notation must have consistent depths.
DEC {"a":1,"b":"x"}                                              -> class=struct size=[1 1]  reenc={"mwdata":{"a":[{"mwdata":[1],"mwsize":[1,1],"mwtype":"double"}],"b":[{"mwdata":["x"],"mwsize":[1,1],"mwtype":"char"}]},"mwsize":[1,1],"mwtype":"struct"}
DEC [{"a":1},{"a":2}]                                            -> ERR MPS:MATLAB:JSON:DecodeInvalidArrayElemType : Arrays in small notation must contain JSON numbers, JSON booleans, or values {"mwdata":"NaN"}, {"mwdata":"Inf"}, or {"mwdata": "-Inf"}
DEC [{"a":1},{"b":2}]                                            -> ERR MPS:MATLAB:JSON:DecodeInvalidArrayElemType : Arrays in small notation must contain JSON numbers, JSON booleans, or values {"mwdata":"NaN"}, {"mwdata":"Inf"}, or {"mwdata": "-Inf"}
DEC null                                                         -> ERR MPS:MATLAB:JSON:DecodeInvalidMWType : Unsupported "mwtype": "Input value is either foundation::json::Undefined or foundation::json::Null. The value cannot be converted to MATLAB Data Array.".
DEC [null]                                                       -> ERR MPS:MATLAB:JSON:DecodeInvalidArrayElemType : Arrays in small notation must contain JSON numbers, JSON booleans, or values {"mwdata":"NaN"}, {"mwdata":"Inf"}, or {"mwdata": "-Inf"}
DEC "NaN"                                                        -> class=char size=[1 3]  reenc={"mwdata":["NaN"],"mwsize":[1,3],"mwtype":"char"}
DEC {"mwdata":"NaN"}                                             -> class=double size=[1 1]  reenc={"mwdata":["NaN"],"mwsize":[1,1],"mwtype":"double"}
DEC {"mwdata":[1,2,3,4],"mwsize":[2,2],"mwtype":"double"}        -> class=double size=[2 2]  reenc={"mwdata":[1,2,3,4],"mwsize":[2,2],"mwtype":"double"}
DEC {"mwdata":[1],"mwsize":[1,1],"mwtype":"int8"}                -> class=int8 size=[1 1]  reenc={"mwdata":[1],"mwsize":[1,1],"mwtype":"int8"}
DEC {"mwdata":["ab","cd"],"mwsize":[2,2],"mwtype":"char"}        -> ERR MPS:MATLAB:JSON:DecodeInvalidCharArrayMWData : "mwdata" for char array must be in the format '["..."]'.
DEC {"mwdata":["ab"],"mwsize":[1,2],"mwtype":"char"}             -> class=char size=[1 2]  reenc={"mwdata":["ab"],"mwsize":[1,2],"mwtype":"char"}
DEC {"mwdata":[true,false],"mwsize":[1,2],"mwtype":"logical"}    -> class=logical size=[1 2]  reenc={"mwdata":[true,false],"mwsize":[1,2],"mwtype":"logical"}
DEC {"mwdata":[1,2],"mwsize":[1,2],"mwtype":"double","mwcomplex":true} -> ERR MPS:MATLAB:JSON:DecodeMismatchedMWSize : Number of elements in "mwdata" does not match "mwsize" specified.
DEC {"mwcomplex":true,"mwdata":[{"real":1,"imag":2}],"mwsize":[1,1],"mwtype":"double"} -> ERR MPS:MATLAB:JSON:DecodeIncompleteComplexData : Unexpected end of complex number data
DEC {"mwdata":{"real":[1],"imag":[2]},"mwsize":[1,1],"mwtype":"double","mwcomplex":true} -> ERR MPS:MATLAB:JSON:DecodeInvalidMWDataType : "mwdata" for double arrays must be a JSON array.
DEC {"mwdata":[{"mwdata":[1],"mwsize":[1,1],"mwtype":"double"},{"mwdata":["x"],"mwsize":[1,1],"mwtype":"char"}],"mwsize":[1,2],"mwtype":"cell"} -> class=cell size=[1 2]  reenc={"mwdata":[{"mwdata":[1],"mwsize":[1,1],"mwtype":"double"},{"mwdata":["x"],"mwsize":[1,1],"mwtype":"char"}],"mwsize":[1,2],"mwtype":"cell"}
DEC {"mwdata":{"a":[{"mwdata":[1],"mwsize":[1,1],"mwtype":"double"}]},"mwsize":[1,1],"mwtype":"struct"} -> class=struct size=[1 1]  reenc={"mwdata":{"a":[{"mwdata":[1],"mwsize":[1,1],"mwtype":"double"}]},"mwsize":[1,1],"mwtype":"struct"}
DEC {"mwdata":["a","b"],"mwsize":[1,2],"mwtype":"string"}        -> class=string size=[1 2]  reenc={"mwdata":["a","b"],"mwsize":[1,2],"mwtype":"string"}
DEC 1e400                                                        -> class=double size=[1 1]  reenc={"mwdata":["Inf"],"mwsize":[1,1],"mwtype":"double"}
DEC -0                                                           -> class=double size=[1 1]  reenc={"mwdata":[-0],"mwsize":[1,1],"mwtype":"double"}
DEC 1.5                                                          -> class=double size=[1 1]  reenc={"mwdata":[1.5],"mwsize":[1,1],"mwtype":"double"}
DEC [1.5,2]                                                      -> class=double size=[2 1]  reenc={"mwdata":[1.5,2],"mwsize":[2,1],"mwtype":"double"}
DEC 12345678901234567890                                         -> class=double size=[1 1]  reenc={"mwdata":[1.2345678901234567E+19],"mwsize":[1,1],"mwtype":"double"}

