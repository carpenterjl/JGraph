<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JGraph.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit theory data and generated test scaffolding trip doc-comment warnings. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Theme-key parity. JGraph.Controls is net8.0-windows and unreachable from here, but neither half
    of the contract actually needs WPF: ThemeKeys is nothing but string constants, and a theme
    dictionary is plain XML to an XDocument. Linking the one and copying the others lets the most
    valuable theming test run in the standard gate.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\JGraph.Controls\Themes\ThemeKeys.cs" Link="Theming\ThemeKeys.cs" />
    <Content Include="..\..\src\JGraph.Controls\Themes\*.xaml"
             Link="Themes\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    MATLAB parity fixtures (M124). The .m scripts and MATLAB's recorded answers ride along to the
    output folder so MatlabParityFixtureTests can read them by path; MATLAB itself is never run.
    fixtures\helpers\ holds the class and function files fixtures share; it rides along too, and
    the harness puts it on the function path rather than enumerating it (it holds no fixtures).
    A fixture's .owners sidecar names the stage that owns each line JGraph is known to fail; the
    stamp mode reads it.
  -->
  <ItemGroup>
    <Content Include="MatlabParity\fixtures\*.m;MatlabParity\fixtures\*.jgs;MatlabParity\fixtures\*.owners;MatlabParity\fixtures\helpers\*.m;MatlabParity\fixtures\helpers\*.mlapp;MatlabParity\fixtures\helpers\*.fig;MatlabParity\fixtures\helpers\*.html;MatlabParity\fixtures\helpers\*.cs;MatlabParity\expected\*.txt"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- A fixture's C# helper is compiled by jgraph.net.compile at run time (ADR 0179), never by this project. -->
    <Compile Remove="MatlabParity\fixtures\**\*.cs" />
  </ItemGroup>

  <!--
    Interop parity assets (interop plan, step 0). The net_* and shrlib_* fixtures load them from
    fixtures\interop\ next to themselves (helpers\interop_paths.m), the folder
    tools\interop\stage-assets.ps1 fills in the source tree for MATLAB. Here the same files come
    from where they are committed: the MSVC build of jgtestlib.dll, its headers, and the prototype
    file R2025b wrote. The .NET test assembly is built through the project reference below and
    copied after the build, since its output does not exist when this project is evaluated.
  -->
  <ItemGroup>
    <Content Include="..\Interop\native\win-x64\jgtestlib.dll;..\Interop\native\jgtestlib.h;..\Interop\native\jgtestlib_win.h;..\Interop\native\jgtestlib_proto.m"
             Link="MatlabParity\fixtures\interop\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- The header parser's tests (ADR 0181): the preprocessed headers and R2025b's prototype files for them. -->
    <Content Include="..\Interop\native\jgtestlib.msvc.i"
             Link="MatlabParity\fixtures\interop\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Interop\native\parse\*"
             Link="MatlabParity\fixtures\interop\parse\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\Interop\JGraph.Interop.TestAssembly\JGraph.Interop.TestAssembly.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyInteropTestAssembly" AfterTargets="Build">
    <MSBuild Projects="..\Interop\JGraph.Interop.TestAssembly\JGraph.Interop.TestAssembly.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_InteropTestAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_InteropTestAssembly)" DestinationFolder="$(OutDir)MatlabParity\fixtures\interop"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- The 30-digit cosine-transform reference tools/transforms/dct_reference.py writes (ADR 0153). -->
  <ItemGroup>
    <Content Include="Numerics\dct_reference.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Numerics\fft_reference.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JGraph.Core\JGraph.Core.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Data\JGraph.Data.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Math\JGraph.Math.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Rendering\JGraph.Rendering.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Objects\JGraph.Objects.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Numerics\JGraph.Numerics.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Signal\JGraph.Signal.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Imaging\JGraph.Imaging.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Imaging.Codecs\JGraph.Imaging.Codecs.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Serialization\JGraph.Serialization.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Interaction\JGraph.Interaction.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Api\JGraph.Api.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Export\JGraph.Export.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Plugins\JGraph.Plugins.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Scripting\JGraph.Scripting.csproj" />
    <ProjectReference Include="..\..\src\JGraph.Reporting\JGraph.Reporting.csproj" />
  </ItemGroup>

  <!-- uihtml's WebView2 host (U9b), copied beside the program. -->
  <Import Project="..\..\src\JGraph.Controls.Web\IncludeHtmlHost.targets" />

</Project>
