# net_jgs_smoke.jgs -- the .NET interface from the JGS dialect (interop plan, stage 1, ADR 0174).
# A JGraph-only fixture: R2025b cannot run JGS, so expected/net_jgs_smoke.txt is written from the
# rule. JGS has no dotted names, so a JGS script reaches .NET through feval with a dotted name and
# through a MATLAB helper file (V11's dialect crossing); what comes back is the .NET value a MATLAB
# script holds, and the ordinary verbs answer for it in JGS as they do in MATLAB.

print("CHK|feval_static|" + feval("System.Math.Max", 3, 4) + "|exact");
print("CHK|feval_static_int32|" + class(feval("System.Math.Max", int32(3), int32(4))) + "|exact");
let s = ix_net_string("abc");
print("CHK|class|" + class(s) + "|exact");
print("CHK|char|" + char(s) + "|exact");
print("CHK|isa_Object|" + isa(s, "System.Object") + "|exact");
print("CHK|isobject|" + isobject(s) + "|exact");
print("CHK|numel|" + numel(s) + "|exact");
let h = str2func("System.String.Concat");
print("CHK|handle_call|" + char(h("x", "y")) + "|exact");
# Stage 2 (ADR 0175): an out parameter comes back as a second output, which JGS destructures.
let [q, r] = feval("System.Math.DivRem", int32(7), int32(2));
print("CHK|feval_out_parameter|" + string(q) + " " + string(r) + " " + class(r) + "|exact");
# Stage 3 (ADR 0176): adding an assembly again answers the same NET.Assembly, and import() lists
# what the running code imported - nothing, in JGS, which has no import statement.
let x1 = feval("NET.addAssembly", "System.Xml");
print("CHK|addAssembly_same|" + (x1 == feval("NET.addAssembly", "System.Xml")) + "|exact");
print("CHK|import_list|" + numel(import()) + "|exact");
# Stage 4 (ADR 0177): a .NET array takes JGS's brackets from 0, and writes into the array itself.
let a = feval("NET.createArray", "System.Double", 3);
a[0] = 5;
a[2] = 7;
print("CHK|array_brackets|" + (a[0] + a[2]) + " " + a[1] + "|exact");
print("CHK|GenericClass|" + class(feval("NET.GenericClass", "System.Collections.Generic.List", "System.Double")) + "|exact");
# Stage 8 (ADR 0181): the shared-library names answer in JGS, a prototype function named by text.
let p = interop_paths();
addpath(getfield(p, "root"));
loadlibrary(getfield(p, "lib"), "jgtestlib_proto", "alias", "jgs8");
print("CHK|shrlib_loaded|" + libisloaded("jgs8") + "|exact");
print("CHK|shrlib_call|" + calllib("jgs8", "jg_version") + "|exact");
print("CHK|shrlib_functions|" + numel(libfunctions("jgs8")) + "|exact");
# Stage 9 (ADR 0182): a lib.pointer and a libstruct in JGS, read and written through get and set.
let lp = libpointer("doublePtr", [1, 2, 3]);
calllib("jgs8", "jg_scale_double", lp, 3, 2);
print("CHK|libpointer_written|" + sum(get(lp, "Value")) + "|exact");
print("CHK|libpointer_plus|" + sum(get(lp + 1, "Value")) + "|exact");
let st = libstruct("jg_point");
set(st, "x", 3);
set(st, "y", 4);
print("CHK|libstruct_by_value|" + calllib("jgs8", "jg_point_len", st) + "|exact");
delete(st);
unloadlibrary("jgs8");
print("CHK|shrlib_unloaded|" + libisloaded("jgs8") + "|exact");
print("CHK|mexext|" + mexext() + "|exact");
