<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The .NET assembly both engines load in the interop parity fixtures (plan step 0). It targets
    netstandard2.0 so the same file loads in JGraph (.NET 8) and in R2025b under both
    dotnetenv("core") and dotnetenv("framework"). Every type sits in the JGTest namespace, one
    file per concern. It is written for the probes and the fixtures and ships nowhere.

    Overloads.g.cs is generated by tools/interop/gen-overloads.py; edit the generator, not the
    file.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>JGTest</RootNamespace>
    <AssemblyName>JGraph.Interop.TestAssembly</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- netstandard2.0 has no nullable attributes; a test asset does not need the annotations. -->
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
